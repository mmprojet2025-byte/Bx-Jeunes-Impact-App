# Variables d'environnement du backend Bx-Jeunes Impact.
# Copier ce fichier en .env (ignoré par Git), remplir les valeurs,
# puis les charger avant de lancer l'API (voir README.md).

# Base de données PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/bxji_dev
DB_USERNAME=postgres
DB_PASSWORD=

# Clé de signature JWT, encodée en Base64 (au moins 256 bits).
# Générer une clé : openssl rand -base64 32
JWT_SECRET_KEY=

# Origines autorisées par CORS (facultatif, séparées par des virgules)
# CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
